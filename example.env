# MongoDB credentials and database
# Root user created on first start of the mongo container
MONGO_USER=admin
# Password of the MongoDB root user
MONGO_PASS=secretpassword
# Database used by the services
MONGO_DB_NAME=space_weather

# Published host ports (optional, defaults shown)
# Host port for MongoDB
MONGO_HOST_PORT=27017
# Host port for the Streamlit dashboard
FRONTEND_HOST_PORT=8501
# Host port for the Mongo Express admin UI
MONGO_EXPRESS_HOST_PORT=8081

# Mongo Express UI login
# Basic auth user for the Mongo Express web UI
MONGO_EXPRESS_USER=admin-ui
# Basic auth password for the Mongo Express web UI
MONGO_EXPRESS_PASS=ui-secret

# Metadata worker pacing (optional, defaults shown)
# Random pause between two requests to the same provider host, in seconds
METADATA_WORKER_HOST_PAUSE_MIN_SECONDS=30
METADATA_WORKER_HOST_PAUSE_MAX_SECONDS=90
# Sleep when no task is due, in seconds
METADATA_WORKER_IDLE_SLEEP_SECONDS=30
# Share of the interval by which each next run is moved at random
METADATA_WORKER_INTERVAL_JITTER=0.1
# Retry delay after the first failure, doubled per further failure up to the task interval, in seconds
METADATA_WORKER_FAILURE_BACKOFF_SECONDS=900
# Time between two comparisons of the planned requests with the stored tasks, in seconds
METADATA_WORKER_PLAN_INTERVAL_SECONDS=3600
# Time between two reads of the HAPI metadata mirror files, in hours
METADATA_WORKER_HAPI_MIRROR_INTERVAL_HOURS=24

# Tools running outside Docker (notebooks, scripts, tests) must set these themselves,
# because the code defaults point to the mongo service inside the Compose network:
# MONGO_HOST=localhost
# MONGO_PORT=<value of MONGO_HOST_PORT>
